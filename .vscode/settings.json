{
  "files.exclude": {
    "**/.gradle": true,
    "**/build": true,
    "**/.idea": true
  },
  "search.exclude": {
    "**/build": true,
    "**/.gradle": true
  },
  "kotlin.languageServer.enabled": true,
  "java.configuration.updateBuildConfiguration": "automatic",
  "gradle.nestedProjects": true,
  "editor.formatOnSave": true,
  "[kotlin]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[xml]": {
    "editor.tabSize": 4
  }
}
