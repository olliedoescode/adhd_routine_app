<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base theme used before Compose takes over. The real colours live in the
      Compose theme (ui/theme/Theme.kt); this only prevents a white flash on
      launch.
    -->
    <style name="Theme.AdhdRoutineApp" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
