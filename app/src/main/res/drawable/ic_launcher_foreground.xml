<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: a rounded "routine card" holding a progress ring with a
  checkmark inside it, plus two short task bars to the right.

  The mark reads as "a routine, in progress, getting done" rather than the old
  three anonymous stacked bars. Everything is kept inside the 72dp safe zone of
  the 108dp adaptive-icon canvas so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rounded card behind the mark, giving the icon a solid silhouette. -->
    <path
        android:fillColor="#1B1F27"
        android:pathData="M30,26 L78,26 A10,10 0 0 1 88,36 L88,72 A10,10 0 0 1 78,82 L30,82 A10,10 0 0 1 20,72 L20,36 A10,10 0 0 1 30,26 Z" />

    <!-- Progress ring: a full faint track with a bright three-quarter arc. -->
    <path
        android:strokeColor="#2E3644"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M42,54 m-13,0 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0" />

    <path
        android:strokeColor="#4F8EF7"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M42,41 A13,13 0 1 1 31.5,61.5" />

    <!-- Checkmark inside the ring: "done". -->
    <path
        android:strokeColor="#34C7A1"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M36.5,54.5 L40.5,58.5 L48,50.5" />

    <!-- Two task bars to the right, the lower one shorter and amber. -->
    <path
        android:strokeColor="#E8EDF5"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M64,46 L78,46" />

    <path
        android:strokeColor="#F2994A"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M64,62 L72,62" />
</vector>
