    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Left outer plate -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M1,7h2.6v10h-2.6z" />
    <!-- Left inner plate -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.4,5.5h2.2v13h-2.2z" />
    <!-- Bar -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M6.6,10.7h10.8v2.6h-10.8z" />
    <!-- Right inner plate -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M17.4,5.5h2.2v13h-2.2z" />
    <!-- Right outer plate -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M20.4,7h2.6v10h-2.6z" />
</vector>
